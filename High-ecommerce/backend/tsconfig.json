{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["config/**/*.ts", "controller/**/*.ts", "middleware/**/*.ts", "routes/**/*.ts", "services/**/*.ts", "src/**/*.ts", "utils/**/*.ts"]
}
